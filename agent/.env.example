# LëtzEval BAF agent — environment variables
# Copy this file to .env and fill in the values you need.
# Never commit .env to version control.

# ── LLM provider ────────────────────────────────────────────────────────────
# Which LLM backend to use as a fallback when the PyTorch intent classifier
# cannot resolve model names or the user writes in a non-English language.
#
# Choices:
#   none    — no LLM; agent uses only the deterministic pipeline (default)
#   openai  — OpenAI API (requires OPENAI_API_KEY)
#   ollama  — self-hosted Ollama (requires LETZEVAL_OLLAMA_BASE_URL)

LETZEVAL_LLM_PROVIDER=none

# Model name for the chosen provider.
# OpenAI examples:  gpt-4o-mini  gpt-4o  gpt-4-turbo
# Ollama examples:  llama3.1  llama3.1:70b  qwen2.5:7b  mistral
LETZEVAL_LLM_MODEL=

# ── OpenAI (only when LETZEVAL_LLM_PROVIDER=openai) ─────────────────────────
OPENAI_API_KEY=

# ── Ollama (only when LETZEVAL_LLM_PROVIDER=ollama) ─────────────────────────
# NOTE: Inside Docker, "localhost" means the container itself — not the host.
# Use the Docker Compose service name (e.g. http://ollama:11434) or
# host.docker.internal (Docker Desktop on Mac/Windows).
LETZEVAL_OLLAMA_BASE_URL=http://localhost:11434

# LLM request timeout in seconds (default: 12)
LETZEVAL_LLM_TIMEOUT_SECONDS=12

# ── Agent mode ───────────────────────────────────────────────────────────────
# Controls how the BAF agent routes user messages.
#
# Choices:
#   classical  — deterministic PyTorch intent classifier routes directly to
#                handler states; LLM is used only when entity extraction finds
#                zero model-name candidates (default)
#   llm        — every message passes through a bounded LLM interpretation
#                state first; the LLM extracts intent, model name(s), CEFR
#                level, and category, then variable-based transitions route to
#                the correct handler — requires a configured LLM provider above
LETZEVAL_AGENT_MODE=classical
